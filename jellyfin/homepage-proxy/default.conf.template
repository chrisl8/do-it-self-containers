# Compatibility shim for the Homepage Jellyfin widget.
# Jellyfin 12.1 dropped the legacy /emby/* routes and ?api_key= query auth that
# Homepage still uses. This maps the two calls the widget makes onto the modern
# paths and injects the API key as an Authorization header. Nothing else is exposed.
server {
    listen 80;
    resolver 127.0.0.11 valid=30s;  # Docker DNS; needed because proxy_pass uses a variable
    location ~ ^/emby/(Items/Counts|Sessions)$ {
        limit_except GET { deny all; }
        proxy_pass http://jellyfin:8096/$1;
        proxy_set_header Authorization 'MediaBrowser Token="${API_KEY}"';
    }
    location = /healthz {
        return 200;
    }
    location / {
        return 404;
    }
}
